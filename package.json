{
  "name": "screen-gremlin",
  "productName": "ScreenGremlin",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "A mischievous desktop companion that wanders across your screen.",
  "author": "ScreenGremlin",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:pro": "npm run build && SCREEN_GREMLIN_DEV_PRO=1 electron .",
    "check:desktop": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/product-config.cjs",
    "check:license": "node --check scripts/generate-license.mjs",
    "check": "npm run check:desktop && npm run check:license && npm run build",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "license:generate": "node scripts/generate-license.mjs"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "44.3.0",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "build": {
    "appId": "fun.mirco.screengremlin",
    "productName": "ScreenGremlin",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ScreenGremlin-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "artifactName": "ScreenGremlin-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "ScreenGremlin-${version}-${arch}.${ext}"
    }
  }
}
